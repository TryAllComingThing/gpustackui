VITE_API_BASE_URL=/v2
VITE_AUTH_BASE_URL=
# Product display name used by the shell, login page, document title, and breadcrumbs.
VITE_APP_NAME=Vue SaaS Framework
# Deploy under a subpath by setting e.g. /console/. Keep the leading slash; the trailing slash is normalized.
VITE_APP_BASE=/
# Demo business modules use local fixtures. Disable them for real product shells.
VITE_ENABLE_DEMO_MODULES=false
# Optional GPUStack example; requires VITE_ENABLE_DEMO_MODULES=true and is only for compatibility projects.
VITE_ENABLE_GPUSTACK_EXAMPLE=false
# Optional SSO entry URL shown when /auth/config reports SAML or OIDC.
VITE_SSO_LOGIN_URL=
# Production builds always fail closed, regardless of this value.
# Set true to enforce CSRF in non-production builds; false only affects non-production local development.
VITE_CSRF_REQUIRED=
# Must be configured when VITE_CSRF_REQUIRED=true and the backend exposes a JS-readable CSRF cookie.
VITE_CSRF_COOKIE_NAME=
VITE_CSRF_HEADER_NAME=X-CSRF-Token
# Comma-separated HTTPS origins allowed to receive SSO logout redirects.
# Leave empty to reject external logout_url values; never use a wildcard origin.
VITE_TRUSTED_LOGOUT_ORIGINS=
