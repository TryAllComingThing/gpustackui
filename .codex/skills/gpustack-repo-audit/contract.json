{
  "name": "gpustack-repo-audit",
  "version": "1.2.0",
  "inputs": [
    "repository",
    "design_system_version"
  ],
  "constraints": {
    "read_only": true,
    "preserve_api_contract": true,
    "mark_unknowns": true
  },
  "outputs": [
    "page_inventory",
    "api_contract",
    "design_gap",
    "risk_register",
    "migration_recommendation"
  ],
  "checks": [
    "source_review",
    "route_inventory",
    "dependency_and_script_review"
  ]
}
