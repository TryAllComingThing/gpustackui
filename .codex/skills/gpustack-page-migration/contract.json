{
  "name": "gpustack-page-migration",
  "version": "1.2.0",
  "inputs": [
    "source_page",
    "target_page",
    "api_contract",
    "acceptance_cases"
  ],
  "constraints": {
    "preserve_api_contract": true,
    "preserve_business_behavior": true,
    "use_design_tokens": true,
    "respect_module_boundaries": true
  },
  "outputs": [
    "page_implementation",
    "route_integration",
    "locale_updates",
    "tests",
    "migration_notes"
  ],
  "checks": [
    "typecheck",
    "lint",
    "test:unit",
    "affected_e2e"
  ]
}
