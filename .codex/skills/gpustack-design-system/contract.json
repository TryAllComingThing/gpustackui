{
  "name": "gpustack-design-system",
  "version": "1.1.0",
  "inputs": [
    "design_authority",
    "theme_contract",
    "component_matrix"
  ],
  "constraints": {
    "use_design_tokens": true,
    "require_real_evidence": true
  },
  "outputs": [
