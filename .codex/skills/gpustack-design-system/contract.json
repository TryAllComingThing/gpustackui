{
  "name": "gpustack-design-system",
  "version": "1.2.0",
  "inputs": [
    "design_authority",
    "theme_contract",
    "component_matrix"
  ],
  "constraints": {
    "use_design_tokens": true,
    "preserve_public_api": true,
    "production_showcase_same_implementation": true
  },
  "outputs": [
    "token_source_changes",
    "component_or_pattern_changes",
    "showcase_coverage",
    "documentation_updates"
  ],
  "checks": [
    "check:theme-css",
    "check:tokens",
    "typecheck",
    "test:unit",
    "build:showcase"
  ]
}
