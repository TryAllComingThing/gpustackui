{
  "name": "gpustack-vue-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "npm@11.10.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "dev:showcase": "vite --config showcase/vite.config.ts",
    "build:showcase": "npm run typecheck:showcase && vite build --config showcase/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:showcase": "vue-tsc --noEmit -p showcase/tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.showcase.config.ts",
    "test:strict": "playwright test --config playwright.strict.config.ts",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "check:structure": "python3 quality/check_structure.py",
    "check:showcase-isolation": "python3 quality/check_showcase_isolation.py",
    "check:theme-css": "python3 scripts/generate_theme_css.py --check",
    "quality:check": "python3 scripts/quality_check.py",
    "validate:design-contract": "python3 scripts/validate_contracts.py",
    "validate:tokens": "python3 scripts/validate_tokens.py",
    "generate:theme-css": "python3 scripts/generate_theme_css.py",
    "create:module": "node scripts/create_module.mjs",
    "quality:release": "node scripts/quality_release.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^12.8.2",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "pinia": "^3.0.4",
    "vaul-vue": "0.4.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/lucide": "^1.2.150",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
    "minimatch@<11.0.1": "^11.0.1"
  }
}
