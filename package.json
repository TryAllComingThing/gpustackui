{
  "name": "gpustack-vue-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "dev:showcase": "vite --config showcase/vite.config.ts",
    "build:showcase": "pnpm typecheck:showcase && vite build --config showcase/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:showcase": "vue-tsc --noEmit -p showcase/tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.showcase.config.ts",
    "test:strict": "playwright test --config playwright.strict.config.ts",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "check:structure": "python3 quality/check_structure.py",
    "test:showcase": "playwright test --config playwright.showcase.config.ts",
    "check:showcase-isolation": "python3 quality/check_showcase_isolation.py",
    "quality:check": "python3 scripts/quality_check.py",
    "validate:design-contract": "python3 scripts/validate_contracts.py",
    "validate:skills": "python3 scripts/validate_skills.py",
    "validate:f2-tokens": "python3 scripts/validate_f2_tokens.py",
    "validate:f3-tokens": "python3 scripts/validate_f3_tokens.py",
    "generate:saas-visual-foundation": "python3 scripts/generate_saas_visual_foundation.py",
    "validate:saas-visual-foundation": "python3 scripts/validate_saas_visual_foundation.py",
    "generate:theme-css": "python3 scripts/generate_theme_css.py"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.8.0",
    "dayjs": "^1.11.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
